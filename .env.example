# MongoDB replica-set or Atlas URL, including the database name.
# Example for the optional localhost-only Docker replica set:
DATABASE_URL="mongodb://127.0.0.1:27018/mnc_targets?replicaSet=mnc-rs"

# Administrator login. The account is stored in MongoDB (users collection, bcrypt-hashed password).
ADMIN_EMAIL="admin@mncgroups.com"
# One-time setup only: used to create the admin password the first time the app connects to an empty
# database. Remove it from .env after the first sign-in; change the password later from the profile menu.
ADMIN_INITIAL_PASSWORD="choose-a-strong-password-1"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="replace-with-at-least-32-random-characters"
BUSINESS_TIMEZONE="Asia/Kolkata"

# No Google Sheet, Drive, Apps Script, API key, or private key is required.
